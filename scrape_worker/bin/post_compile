#!/usr/bin/env bash
# Runs after pip install (Heroku Python buildpack).
set -euo pipefail

log() { echo "-----> $*" ; }

# Install into the slug being built. Prefer BUILD_DIR (Heroku compile) over the
# runtime config PLAYWRIGHT_BROWSERS_PATH — an absolute /app/.playwright during
# build can land outside the build tree and never ship in the slug.
ROOT="${BUILD_DIR:-/app}"
export PLAYWRIGHT_BROWSERS_PATH="${ROOT}/.playwright"
mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"

log "Installing Playwright Chromium into ${PLAYWRIGHT_BROWSERS_PATH}"
python -m playwright install chromium

log "Playwright Chromium ready at ${PLAYWRIGHT_BROWSERS_PATH}"
