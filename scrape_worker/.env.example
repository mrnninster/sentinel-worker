# Copy to .env and fill in values:
#   cp .env.example .env
#
# Loaded by main.py (worker) and passed through to the embedded scraper.
# Inline comments after values are not supported — keep comments on their own lines.

# =============================================================================
# Worker ↔ coordinator (required for registration / push commands)
# =============================================================================
WORKER_ID=scrape-worker-1
WORKER_SHARED_TOKEN=dev
# Alias for WORKER_SHARED_TOKEN (either works):
# WORKER_TOKEN=

COORDINATOR_URL=http://127.0.0.1:8099
WORKER_PUBLIC_URL=http://127.0.0.1:8100
# Alias for WORKER_PUBLIC_URL:
# PUBLIC_BASE_URL=

# 1/true/yes = self-register on boot; unset = register via admin API
WORKER_REGISTRATION_OPEN=1

# Reported/pool capacity (default 50). Prefer HEROKU_ONEOFF_LIMIT.
WORKER_CAPACITY=50
WORKER_ALLOWED_SOURCES=*
WORKER_HEARTBEAT_SECONDS=30

# =============================================================================
# Dispatch (middleman → one-off dynos or local threads)
# =============================================================================
# Max concurrent jobs this worker can run (default 50).
HEROKU_ONEOFF_LIMIT=50
# Reserved slots so monitors cannot consume the whole pool:
RESERVE_SCRAPE=1
RESERVE_TRANSCRIPT=1
# auto = Heroku if HEROKU_API_KEY+HEROKU_APP_NAME set, else local threads
DISPATCH_MODE=auto
# Shared secret for job → middleman callbacks (defaults to WORKER_SHARED_TOKEN)
# INTERNAL_CALLBACK_TOKEN=
# Heroku Platform API (required on Heroku for one-offs):
# HEROKU_API_KEY=
# HEROKU_APP_NAME=
# HEROKU_DYNO_SIZE=standard-1x

# =============================================================================
# Scraper bridge
# =============================================================================
# embedded (default) | http
SCRAPER_MODE=embedded
# Required when SCRAPER_MODE=http
# SCRAPER_URL=http://127.0.0.1:8080
# Override package root (default: this directory)
# SCRAPER_ROOT=

# =============================================================================
# HTTP server (uvicorn / Docker)
# =============================================================================
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=info
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# =============================================================================
# Embedded scraper / LLM (app.config.Settings)
# =============================================================================
# Required for mode=llm (or auto without schedule_type)
OPENAI_API_KEY=

SCHEDULE_EXTRACTION_MODEL=gpt-4o-mini
SCHEDULE_EXTRACTION_MAX_ATTEMPTS=3
SCHEDULE_EXTRACTION_TIMEOUT=120
SCHEDULE_EXTRACTION_MAX_CHARS=120000

SCRAPE_WAIT_SECONDS=2.0
SCRAPE_WAIT_UNTIL=domcontentloaded
SCRAPE_NAVIGATION_TIMEOUT_MS=30000

# =============================================================================
# Optional: dedicated parsers / YouTube helpers (only if those schedule types run)
# =============================================================================
# SCRAPERAPICOM_API_KEY=
# ARG_YOUTUBE_API_KEY=
# ARG_CHANNEL_URL=
# Skip always-on lives older than this many hours ("Started streaming on …")
# YOUTUBE_MAX_LIVE_AGE_HOURS=24
# ARG_GEO_ID=
# ARG_LOCATION=
# ARG_YOUTUBE_RESTART_ID=
# MUNICODEMEETINGS_LOOKBACK_DAYS=7
# ALLOW_INSECURE_SSL=
# REQUESTS_CA_BUNDLE=
# SSL_CERT_FILE=
# IPB_HTTP=
# IPB_HTTPS=
# LOCAL_STREAMLINK_WORKAROUND=

# Google Calendar parser (schedule_type using googlecal)
# GOOGLE_PROJECT_ID=
# GOOGLE_PRIVATE_KEY_ID=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_X509_CERT_URL=

# Legacy WallFly / Bubble hooks (rare parsers)
# LOCAL_PROJECT_PATH=
# BUBBLE_HKU_KEY=
# HEROKU_APP_DEFAULT_DOMAIN_NAME=
# ENV=
